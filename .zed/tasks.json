[
  {
    "label": "open chapter in browser",
    "command": "pwsh",
    "args": ["-NoProfile", "-Command", "Start-Process (Join-Path $env:ZED_WORKTREE_ROOT 'site/index.html')"],
    "use_new_terminal": false,
    "reveal": "never"
  },
  {
    "label": "rebuild trace 01",
    "command": "python",
    "args": [
      "scripts/build-trace.py",
      "D:/Workspace/Docs/inside-the-loop/recordings/raw-01.jsonl",
      "data/trace-01.json",
      "D:/Workspace/Claude/scratch/itl-rec-01",
      "--prompt", "The tests are failing. Please find the bug and fix it.",
      "--alias", "~/cart",
      "--fixture", "fixtures/cart",
      "--files-out", "out/files-01"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "rebuild trace 03",
    "command": "python",
    "args": [
      "scripts/build-trace.py",
      "D:/Workspace/Docs/inside-the-loop/recordings/raw-03.jsonl",
      "data/trace-03.json",
      "D:/Workspace/Claude/scratch/itl-rec-03",
      "--prompt-file", "D:/Workspace/Docs/inside-the-loop/recordings/prompt-03.txt",
      "--alias", "~/black",
      "--times", "D:/Workspace/Docs/inside-the-loop/recordings/raw-03.times.json",
      "--then", "D:/Workspace/Docs/inside-the-loop/recordings/raw-03-compact.jsonl",
      "--then-times", "D:/Workspace/Docs/inside-the-loop/recordings/raw-03-compact.times.json",
      "--session", "D:/Workspace/Docs/inside-the-loop/recordings/session-03/14aed0d3-99b2-4729-8689-96de34931285.jsonl"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "screenshot check",
    "command": "node",
    "args": ["scripts/screenshot.js", "D:/Workspace/Docs/inside-the-loop/screenshots"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": { "PLAYWRIGHT_BROWSERS_PATH": "D:/Workspace/Cache/ms-playwright" }
  },
  {
    "label": "render video",
    "command": "node",
    "args": ["scripts/render-all.mjs", "D:/Workspace/Docs/inside-the-loop/video"],
    "cwd": "$ZED_WORKTREE_ROOT/video"
  }
]
